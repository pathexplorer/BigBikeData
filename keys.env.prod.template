# ============================================================
# Production Environment Variables (keys.env.prod)
# ============================================================
# Copy this file to <venv>/../keys.env.prod and fill in your production values
# NEVER commit this file to version control!
#
# DO NOT run the bootstrap directly from this file — it also has an interactive
# welcome phase that collects these variables for you if the file is missing.
# Use this template when you want to prefill values before running ./start.sh prod.
#
# The only thing you MUST provide is MY_USER_ACCOUNT (the Google account email
# that owns the GCP project / has billing enabled). Everything else below either
# has a sensible default the script offers, or is auto-generated during Stage 0.
#
# Full variable registry (every variable, its layer, and its consumers):
#   documentation/config-manifest.md

# --- Your Google account (the ONLY strictly-required value) ---
# This is the email of the Google account you will authenticate as.
MY_USER_ACCOUNT=your-email@example.com

# --- GCP Project & Region ---
# Region where all resources will be created.
REGION=us-central1
# Name for the gcloud configuration created by the script.
GCONFIG_NAME=bigbikedata-prod-config

# --- Naming Convention (auto-generated resource names) ---
# Org prefix: 3-20 chars, lowercase, numbers, hyphens.
ORG_PREFIX=bigbikedata
# App name: used in all resource names.
APP_NAME=power-core

# --- Deployer Service Account ---
# Email of the service account used by Cloud Build to deploy (see the
# power_core_run.sh / site_handler_run.sh role setup). The bootstrap script
# (start.sh Stage 5b) CREATES this SA and binds all required roles; only the
# NAME matters here — the email domain is corrected to the bootstrapped project.
SA_DEPLOYER_EMAIL=bike-ci-deployer@bigbikedata.iam.gserviceaccount.com

# --- Site Handler Configuration ---
# Comma-separated allowed domains for Firebase Hosting security middleware.
ALLOWED_DOMAINS=app.bigbikedata.com,bigbikedata.web.app

# --- OPTIONAL: JSON key for the Run service account (usually NOT needed) ---
# The bootstrap authenticates via `gcloud auth application-default login`
# (ADC in ~/.config/gcloud), so this is normally empty/unset.
# Only set it if you want Stage 11 to download a JSON key file to this path.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/prod-service-account.json
