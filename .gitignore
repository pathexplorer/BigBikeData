# Emulator encrypted data (gocryptfs volume — secrets never in plaintext)
.emulator_data/
.emulator_data.enc/
.emulator_data_fs

# Sensitive local paths (webhook URL, etc.)
.webhook_path

# Internal team notes (URLs, non-secret but not for the public repo)
INTERNAL_URLS.md

# Encrypted external-services wizard state (gpg) — never plaintext
.external_services.*.gpg

# Python compiled files
__pycache__
*.pyc
*.pyo
*.pyd

# Testing and Coverage
.pytest_cache
.coverage
htmlcov/
_local_tests/
other/

